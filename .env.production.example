# ============================================================
# The Rampant Club — Production Environment Variables
# Set these in Vercel → Project Settings → Environment Variables.
# Lists exactly the vars this codebase reads (grep process.env). Copy real
# values from your .env.local; never commit secrets.
# ============================================================

# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (required) ──
# Absolute base URL — used for email links (digests, ops notifications) and
# anywhere we build absolute URLs server-side.
NEXT_PUBLIC_SITE_URL=https://therampantclub.com

# ── Email — Resend (required for any email) ──
# Powers the weekly digest, agreement reminders, and Ops Hub notifications.
# From-addresses are set in code on the verified therampantclub.com domain.
RESEND_API_KEY=
# Comma-separated recipients for the Sunday weekly digest.
DIGEST_RECIPIENTS=

# ── Cron auth (required for scheduled jobs) ──
# Vercel Cron sends this as the X-CRON-SECRET / Bearer header. Guards:
#   /api/cron/weekly-digest, /api/cron/decay-fit,
#   /api/cron/ops-materialise (recurring tasks), /api/cron/notify-daily
#   (due-soon notifications + the 09:00-VN email sweep).
CRON_SECRET=

# ── AI — Caddie (required for the AI feature) ──
ANTHROPIC_API_KEY=

# ── Optional ──
# Enables the MIS demo data path. Leave unset in production.
MIS_DEMO_ENABLED=
